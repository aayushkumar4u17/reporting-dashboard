/*
  # Security Headers for Production
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://www.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.fuelbuddy.in https://graphql.fuelbuddy.in https://identitytoolkit.googleapis.com https://securetoken.googleapis.com wss://graphql.fuelbuddy.in; frame-src https://www.google.com; object-src 'none'; base-uri 'self'

/api/*
  # API specific headers
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/assets/*
  # Static assets caching
  Cache-Control: public, max-age=31536000, immutable

/*.js
  # JavaScript files
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript

/*.css
  # CSS files
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css